# Copy to .env.local for local development. Never commit real values.

# Public. Overrides the production URL from src/site.config.ts (e.g. http://localhost:3000 for e2e).
NEXT_PUBLIC_SITE_URL=

# Server-only. Newsletter form shows "coming soon" when unset.
BUTTONDOWN_API_KEY=

# Server-only. Set both for a rate limit shared across instances; empty = in-memory limit per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only. Search engine ownership verification tokens (content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
