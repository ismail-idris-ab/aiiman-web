{
  "name": "aiiman-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aiiman/web dev",
    "dev:admin": "pnpm --parallel --filter @aiiman/api --filter @aiiman/admin dev",
    "build": "pnpm --filter @aiiman/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
