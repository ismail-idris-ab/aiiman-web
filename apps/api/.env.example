# Copy to .env.local for local development. Never commit real values.

# Server-only. MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=

# Optional. Database name inside the cluster (default: aiiman).
MONGODB_DB=

# Optional. Shared login-attempt limit across instances; empty = per-instance memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The site's revalidation endpoint and its shared secret (32+ random characters,
# same value as REVALIDATE_SECRET on the site). Unset = publishing works, the site refreshes on its next build.
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=

# Optional. Vercel "Protection Bypass for Automation" secret of the site project,
# needed only when the site's preview deployments are protected.
SITE_PROTECTION_BYPASS=
