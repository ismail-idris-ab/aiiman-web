# Copy to .env.local for local development. Never commit real values.

# Server-only. MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=

# Optional. Database name inside the cluster (default: aiiman).
MONGODB_DB=

# Optional. Shared login-attempt limit across instances; empty = per-instance memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The site's origin (e.g. https://<site-preview>.vercel.app) and a shared secret
# (32+ random characters, same value as SITE_API_SECRET on the site). Used to refresh the site
# after a publish and to sign draft previews. Unset: publishing works, previews are unavailable.
SITE_URL=
SITE_API_SECRET=

# Optional. Vercel "Protection Bypass for Automation" secret of the site project,
# needed only when the site's preview deployments are protected.
SITE_PROTECTION_BYPASS=

# Server-only. Vercel Blob read-write token (set by connecting a public Blob store to the
# admin project). Unset: image uploads answer 503 and everything else works.
BLOB_READ_WRITE_TOKEN=
