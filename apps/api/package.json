{
  "name": "@aiiman/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @aiiman/shared build",
    "dev": "tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "create-admin": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@aiiman/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@upstash/redis": "^1.39.0",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
